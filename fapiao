        title="选择发票文件",
        filetypes=[("所有支持格式", "*.pdf;*.ofd;*.xml;*.jpg;*.png;*.jpeg")],
        multiple=True)
    if file_paths:
        path_var.set(file_paths)
    return file_paths


def shibie(a):
    url = "https://aip.baidubce.com/rest/2.0/ocr/v1/vat_invoice?access_token=" + get_access_token()

    pdf_file = get_file_content_as_base64(a, True)
    if a.endswith((".pdf")):
        biaotou = "pdf_file=" + pdf_file
    elif a.endswith((".ofd")):
        biaotou = "ofd_file=" + pdf_file
    else:
        biaotou = "image=" + pdf_file
    payload = biaotou
    headers = {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Accept': 'application/json'
    }

    response = requests.request("POST", url, headers=headers, data=payload)
    json_data = response.text
    data = json.loads(json_data)

    # 定义常量
    STR_DEFAULT = '无'  # 字符串默认值
    LIST_DEFAULT = [('1', STR_DEFAULT)]  # 列表默认值
    NUM_DEFAULT = 0  # 数值默认值

    # 辅助函数：填充字段至最大行数，确保所有商品字段行数一致
    def fill_rows(items, max_row, default_word=STR_DEFAULT):
        filled = []
        for i in range(1, max_row + 1):
            # 按行号匹配数据，缺失行用默认值填充
            row_data = next((item for item in items if item['row'] == str(i)), None)
            if row_data:
                filled.append((str(i), row_data['word']))
            else:
                filled.append((str(i), default_word))
        return filled

    # 提取所有商品字段原始数据（避免直接使用or LIST_DEFAULT导致行数固定为1）
    commodity_fields = {
        'name': data['words_result'].get('CommodityName', []),  # 商品名称
        'amount': data['words_result'].get('CommodityAmount', []),  # 不含税金额
        'tax': data['words_result'].get('CommodityTax', []),  # 税额
        'unit': data['words_result'].get('CommodityUnit', []),  # 单位
        'price': data['words_result'].get('CommodityPrice', []),  # 单价（解决为空时错位的核心字段）
        'tax_rate': data['words_result'].get('CommodityTaxRate', []),  # 税率
        'num': data['words_result'].get('CommodityNum', []),  # 数量
        'type': data['words_result'].get('CommodityType', []),  # 规格型号
    }

    # 计算最大行数（动态适配多商品场景，避免行数不一致）
    max_rows = max(len(items) for items in commodity_fields.values()) if any(commodity_fields.values()) else 1
    if max_rows == 0:
        max_rows = 1  # 兜底：至少保留1行

    # 统一填充所有商品字段至最大行数，解决字段为空或行数不足导致的错位
    kaipiaoneirong = fill_rows(commodity_fields['name'], max_rows)
    buhanshuijine = fill_rows(commodity_fields['amount'], max_rows)
    shuie = fill_rows(commodity_fields['tax'], max_rows)
    danwei = fill_rows(commodity_fields['unit'], max_rows)
    danjia = fill_rows(commodity_fields['price'], max_rows)  # 单价字段按最大行数填充
    shuilv = fill_rows(commodity_fields['tax_rate'], max_rows)
    shuliang = fill_rows(commodity_fields['num'], max_rows)
    guigexinghao = fill_rows(commodity_fields['type'], max_rows)

    # 提取非商品字段（单值字段，无需处理行数）
    fapiaoleixing = data['words_result']['InvoiceTypeOrg']
    xiaofeileixing = data['words_result']['ServiceType']
    fapiaobiaozhi = data['words_result']['InvoiceTag']
    goumaifangmingcheng = data['words_result']['PurchaserName']
    goumaifangshuihao = data['words_result']['PurchaserRegisterNum']
    xiaoshoufangmingcheng = data['words_result']['SellerName']
    xiaoshoufangshuihao = data['words_result']['SellerRegisterNum']
    kaipiaoriqi = data['words_result']['InvoiceDate']
    fapiaohaoma = data['words_result']['InvoiceNum']

    # 合并商品字段数据（此时所有字段行数已统一，不会错位）
    combined_dict = defaultdict(list)
    for key, kpnr in kaipiaoneirong: combined_dict[key].append(kpnr)
    for key, bhsje in buhanshuijine: combined_dict[key].append(bhsje)
    for key, se in shuie: combined_dict[key].append(se)
    for key, dw in danwei: combined_dict[key].append(dw)
    for key, dj in danjia: combined_dict[key].append(dj)  # 单价数据已按最大行数填充
    for key, sl in shuilv: combined_dict[key].append(sl)
    for key, shul in shuliang: combined_dict[key].append(shul)
    for key, ggxh in guigexinghao: combined_dict[key].append(ggxh)

    # 构建DataFrame并整理格式
    df = pd.DataFrame.from_dict(combined_dict, orient='index')
    df.columns = ['开票内容', '不含税金额', '税额', '单位', '单价', '税率', '数量', '规格型号']
    df.fillna('', inplace=True)

    # 添加发票头部信息
    df['发票类型'] = fapiaoleixing
    df['消费类型'] = xiaofeileixing
    df['增值税发票左上角标志'] = fapiaobiaozhi
    df['购方名称'] = goumaifangmingcheng
    df['购方税号'] = goumaifangshuihao
    df['销售方名称'] = xiaoshoufangmingcheng
    df['销售方税号'] = xiaoshoufangshuihao
    df['开票日期'] = kaipiaoriqi
    df['发票号码'] = fapiaohaoma
    df['文件地址'] = a
    df['价税合计'] = df['不含税金额'] + df['税额']

    # 调整列顺序
    df = df[['发票号码', '开票日期', '发票类型', '消费类型', '增值税发票左上角标志', '购方名称', '购方税号',
             '销售方名称', '销售方税号', '开票内容', '单位', '不含税金额', '税额', '价税合计', '单价', '税率', '数量',
             '规格型号', '文件地址']]

    return df


def get_file_content_as_base64(path, urlencoded=False):
    with open(path, "rb") as f:
        content = base64.b64encode(f.read()).decode("utf8")
        if urlencoded:
            content = urllib.parse.quote_plus(content)
    return content


def get_access_token():
    # 从输入框获取最新密钥
    url = "https://aip.baidubce.com/oauth/2.0/token"
    params = {
        "grant_type": "client_credentials",
        "client_id": api_key_var.get(),
        "client_secret": secret_key_var.get()
    }
    return str(requests.post(url, params=params).json().get("access_token"))


def parse_einvoice(a):

    tree = ET.parse(a)
    root = tree.getroot()
    header = root.find('Header')
    tax_supervision = root.find('TaxSupervisionInfo')
    base_info = {
        '发票号码': tax_supervision.find('InvoiceNumber').text,
        '开票日期': tax_supervision.find('IssueTime').text,
        '发票类型': header.find('.//GeneralOrSpecialVAT/LabelName').text,
        '消费类型': header.find('.//UndefinedLabel/Label[1]/LabelName').text,
        '增值税发票左上角标志': "其他",
        '购方名称': root.find('.//BuyerInformation/BuyerName').text,
        '购方税号': root.find('.//BuyerInformation/BuyerIdNum').text,
        '销售方名称': root.find('.//SellerInformation/SellerName').text,
        '销售方税号': root.find('.//SellerInformation/SellerIdNum').text,
    }
    items = []
    for idx, item in enumerate(root.findall('.//IssuItemInformation'), 1):
        item_data = {
            '开票内容': item.findtext('ItemName'),
            '单位': item.findtext('MeaUnits'),
            '不含税金额': item.findtext('Amount'),
            '税额': item.findtext('ComTaxAm'),
            '单价': item.findtext('UnPrice'),
            '税率': item.findtext('TaxRate'),
            '数量': item.findtext('Quantity'),
            '规格型号': item.findtext('SpecMod'),
            '价税合计': item.findtext('TotaltaxIncludedAmount'),
            '文件地址': a
        }
        items.append({**base_info, **item_data})
    return pd.DataFrame(items)


def main1():
    global global_result_df
    result = pd.DataFrame()
    lujing = open_file_dialog()
    for b in lujing:
        if b.endswith(".xml"):
            df = parse_einvoice(b)
            numeric_cols = ['数量', '单价', '不含税金额', '税额', '价税合计']
            df[numeric_cols] = df[numeric_cols].apply(pd.to_numeric, errors='coerce')
            columns_order = ['发票号码', '开票日期', '发票类型', '消费类型', '增值税发票左上角标志', '购方名称',
                             '购方税号',
                             '销售方名称', '销售方税号', '开票内容', '单位', '不含税金额', '税额','价税合计', '单价', '税率',
                             '数量',
                             '规格型号', '文件地址']
            d = df[columns_order]
            result = pd.concat([result, d], ignore_index=True)
        else:
            c = shibie(b)
            result = pd.concat([result, c], ignore_index=True)
            result['不含税金额'] = pd.to_numeric(result['不含税金额'], errors='coerce')
            result['税额'] = pd.to_numeric(result['税额'], errors='coerce')
            result['价税合计']=result['不含税金额']+result['税额']
    global_result_df = result.copy()
    messagebox.showinfo("成功", f"已完成 {len(lujing)} 个文件的识别！")


def on_export_click():
    global global_result_df
    try:
        if global_result_df.empty:
            messagebox.showwarning("提示", "请先点击【打开文件选择框】处理发票！")
            return
        output_dir = filedialog.askdirectory(title="选择输出文件夹", parent=root, mustexist=True)
        if not output_dir:
            messagebox.showinfo("提示", "已取消导出")
            return
        current_time = datetime.datetime.now().strftime("%Y%m%d%H%M%S")
        filename = f"发票内容识别_{current_time}.xlsx"
        file_path = os.path.join(output_dir, filename)
        global_result_df.to_excel(file_path, index=False)
        messagebox.showinfo("成功", f"文件已保存至：\n{output_dir}")
    except Exception as e:
        messagebox.showerror("错误", f"导出失败：{str(e)}")


